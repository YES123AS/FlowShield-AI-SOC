# Copy this file to .env. Never commit the resulting .env file.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
MAX_CONTENT_LENGTH=20971520

# Local no-setup development
DB_ENGINE=sqlite
DB_NAME=traffic_system.db

# MySQL deployment (uncomment and replace every value if needed)
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=traffic_system
# DB_USER=replace-with-database-user
# DB_PASSWORD=replace-with-a-strong-database-password

# Create administrators explicitly with `python create_admin.py`.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTO_CREATE_ADMIN=false

DETECTOR_BACKEND=transformer
TRANSFORMER_MODEL_PATH=models/transformer_best.pt
TRANSFORMER_SCALER_PATH=models/scaler.joblib
TRANSFORMER_BATCH_SIZE=512
TRANSFORMER_MALICIOUS_FLOW_THRESHOLD=0.30
TRANSFORMER_DRIFT_Z_THRESHOLD=8.0

# Fallback model
# DETECTOR_BACKEND=residual_mlp
# RESIDUAL_MLP_MODEL_PATH=models/residual_mlp_best.pt
# RESIDUAL_MLP_SCALER_PATH=models/scaler.joblib

# Optional DeepSeek integration. Create a fresh key after cloning; never put it in Git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ENABLE=false
